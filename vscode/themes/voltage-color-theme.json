{
  "name": "Voltage",
  "type": "dark",
  "colors": {
    "editor.background": "#0d1117",
    "editor.foreground": "#ffffff",
    "editor.lineHighlightBackground": "#6e76811a",
    "editor.selectionBackground": "#264f78",
    "editorCursor.foreground": "#ff3333",
    "editorLineNumber.foreground": "#6e7681",
    "editorLineNumber.activeForeground": "#ffffff",
    "editorIndentGuide.background": "#e6edf31f",
    "editorIndentGuide.activeBackground": "#e6edf33d",
    "editorWhitespace.foreground": "#484f58",

    "sideBar.background": "#010409",
    "sideBar.foreground": "#c9c9c9",
    "sideBarTitle.foreground": "#ffffff",
    "activityBar.background": "#0d1117",
    "activityBar.foreground": "#ffffff",
    "activityBarBadge.background": "#00d4ff",
    "activityBarBadge.foreground": "#0d1117",

    "statusBar.background": "#0d1117",
    "statusBar.foreground": "#c9c9c9",
    "statusBar.noFolderBackground": "#0d1117",
    "statusBar.debuggingBackground": "#ff6b9d",
    "statusBar.debuggingForeground": "#0d1117",

    "titleBar.activeBackground": "#0d1117",
    "titleBar.activeForeground": "#c9c9c9",
    "titleBar.inactiveBackground": "#010409",

    "panel.background": "#010409",
    "panel.border": "#30363d",
    "panelTitle.activeForeground": "#ffffff",

    "editorGroupHeader.tabsBackground": "#010409",
    "tab.activeBackground": "#0d1117",
    "tab.inactiveBackground": "#010409",
    "tab.activeForeground": "#ffffff",
    "tab.inactiveForeground": "#7a7a7a",
    "tab.activeBorderTop": "#00d4ff",

    "terminal.background": "#0d1117",
    "terminal.foreground": "#ffffff",
    "terminal.ansiBlack": "#0d1117",
    "terminal.ansiRed": "#ff6b9d",
    "terminal.ansiGreen": "#00ff41",
    "terminal.ansiYellow": "#ffcc00",
    "terminal.ansiBlue": "#4fc1ff",
    "terminal.ansiMagenta": "#bd93f9",
    "terminal.ansiCyan": "#00d4ff",
    "terminal.ansiWhite": "#ffffff",
    "terminal.ansiBrightBlack": "#4d4d4d",
    "terminal.ansiBrightRed": "#ff8fb3",
    "terminal.ansiBrightGreen": "#5cff8a",
    "terminal.ansiBrightYellow": "#ffe066",
    "terminal.ansiBrightBlue": "#82e2ff",
    "terminal.ansiBrightMagenta": "#d4b3ff",
    "terminal.ansiBrightCyan": "#82e2ff",
    "terminal.ansiBrightWhite": "#ffffff",

    "editorBracketHighlight.foreground1": "#ffd700",
    "editorBracketHighlight.foreground2": "#da70d6",
    "editorBracketHighlight.foreground3": "#87ceeb",
    "editorBracketHighlight.foreground4": "#ff6347",
    "editorBracketHighlight.foreground5": "#98fb98",
    "editorBracketHighlight.foreground6": "#ffaa44",

    "gitDecoration.addedResourceForeground": "#00ff41",
    "gitDecoration.modifiedResourceForeground": "#ffcc00",
    "gitDecoration.deletedResourceForeground": "#ff3333",
    "gitDecoration.untrackedResourceForeground": "#00ff41",
    "diffEditor.insertedTextBackground": "#00ff4122",
    "diffEditor.removedTextBackground": "#ff333322"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#7cb668" } },
    { "scope": ["comment keyword.codetag", "comment.line keyword", "comment.block keyword"], "settings": { "foreground": "#FF0000", "fontStyle": "bold" } },
    { "scope": "string", "settings": { "foreground": "#00ff41" } },
    { "scope": ["keyword", "keyword.control"], "settings": { "foreground": "#ff6b9d" } },
    { "scope": ["storage.type", "storage.modifier"], "settings": { "foreground": "#ffa657" } },
    { "scope": ["entity.name.function"], "settings": { "foreground": "#00d4ff" } },
    { "scope": ["support.function", "variable.function"], "settings": { "foreground": "#82e2ff" } },
    { "scope": ["entity.name.type", "support.type", "support.class"], "settings": { "foreground": "#4fc1ff" } },
    { "scope": ["variable", "variable.other.readwrite"], "settings": { "foreground": "#ffffff" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#ffdd88" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "variable.other.object.member", "meta.struct.variable"], "settings": { "foreground": "#ff6b9d" } },
    { "scope": ["meta.port-net-parameter.declaration.systemverilog variable.other.identifier.systemverilog"], "settings": { "foreground": "#ffdd88" } },
    { "scope": ["support.type.direction.systemverilog", "storage.type.vector.systemverilog"], "settings": { "foreground": "#4fc1ff" } },
    { "scope": ["variable.other.identifier.systemverilog"], "settings": { "foreground": "#ffffff" } },
    { "scope": ["variable.language", "variable.other.constant"], "settings": { "foreground": "#00d4ff" } },
    { "scope": ["variable.other.enummember", "constant.other.enum"], "settings": { "foreground": "#ffcc00" } },
    { "scope": ["entity.name.function.preprocessor", "meta.preprocessor.macro"], "settings": { "foreground": "#ffcc00" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#ff6b9d" } },
    { "scope": ["entity.name.tag", "support.class.component"], "settings": { "foreground": "#00d4ff" } },
    { "scope": "entity.other.attribute-name", "settings": { "foreground": "#b8c5ff" } },
    { "scope": ["punctuation.definition.template-expression"], "settings": { "foreground": "#ff6b9d" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#ffffff" } },
    { "scope": ["support.function.tcl", "entity.name.function.tcl"], "settings": { "foreground": "#00d4ff" } },
    { "scope": ["variable.other.tcl"], "settings": { "foreground": "#ffffff" } },
    { "scope": ["constant.other.option.tcl", "support.function.tcl-option"], "settings": { "foreground": "#ffa657" } },
    { "scope": ["keyword.control.tcl"], "settings": { "foreground": "#ff6b9d" } },
    { "scope": ["keyword.operator.logical.python"], "settings": { "foreground": "#ffcc00" } }
  ]
}
