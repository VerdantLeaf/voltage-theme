{
  "name": "voltage-theme",
  "displayName": "Voltage Theme",
  "description": "A high-contrast, vibrant dark theme with clear semantic distinctions between declarations, types, parameters, struct/signal access, and control flow.",
  "version": "1.3.1",
  "publisher": "VerdantLeaf",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/VerdantLeaf/voltage-theme.git"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes",
    "Programming Languages"
  ],
  "keywords": [
    "theme",
    "dark",
    "high contrast",
    "systemverilog",
    "cuda",
    "nanorc"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Voltage",
        "uiTheme": "vs-dark",
        "path": "./themes/voltage-color-theme.json"
      }
    ],
    "markdown.previewStyles": [
      "./media/markdown-preview.css"
    ],
    "languages": [
      {
        "id": "nanorc",
        "aliases": [
          "nanorc",
          "Nano Config"
        ],
        "extensions": [
          ".nanorc"
        ],
        "filenames": [
          ".nanorc",
          "nanorc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nanorc",
        "scopeName": "source.nanorc",
        "path": "./syntaxes/nanorc.tmLanguage.json"
      }
    ]
  }
}
