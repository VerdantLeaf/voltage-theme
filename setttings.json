{
  "editor.tokenColorCustomizations": {
    "[GitHub Dark Default]": {
      "comments": "#7cb668",
      "strings": "#00ff41",
      "numbers": "#ff6b9d",
      "keywords": "#ff6b9d",
      "types": "#4fc1ff",
      "functions": "#00d4ff",
      "variables": "#ffffff",
      "textMateRules": [
        {
          "scope": "string",
          "settings": {
            "foreground": "#00ff41"
          }
        },
        {
          "scope": [
            "keyword",
            "keyword.control"
          ],
          "settings": {
            "foreground": "#ff6b9d"
          }
        },
        {
          "scope": [
            "storage.type",
            "storage.modifier"
          ],
          "settings": {
            "foreground": "#ffa657"
          }
        },
        {
          "scope": [
            "entity.name.function"
          ],
          "settings": {
            "foreground": "#00d4ff"
          }
        },
        {
          "scope": [
            "support.function",
            "variable.function"
          ],
          "settings": {
            "foreground": "#82e2ff"
          }
        },
        {
          "scope": [
            "entity.name.type",
            "support.type",
            "support.class"
          ],
          "settings": {
            "foreground": "#4fc1ff"
          }
        },
        {
          "scope": [
            "variable",
            "variable.other.readwrite"
          ],
          "settings": {
            "foreground": "#ffffff"
          }
        },
        {
          "scope": [
            "variable.parameter"
          ],
          "settings": {
            "foreground": "#ffdd88"
          }
        },
        {
          "scope": [
            "variable.other.property",
            "variable.other.object.property",
            "support.variable.property",
            "variable.other.object.member",
            "meta.struct.variable"
          ],
          "settings": {
            "foreground": "#ff6b9d"
          }
        },
        {
          "scope": [
            "meta.port-net-parameter.declaration.systemverilog variable.other.identifier.systemverilog"
          ],
          "settings": {
            "foreground": "#ffdd88"
          }
        },
        {
          "scope": [
            "support.type.direction.systemverilog",
            "storage.type.vector.systemverilog"
          ],
          "settings": {
            "foreground": "#4fc1ff"
          }
        },
        {
          "scope": [
            "variable.other.identifier.systemverilog"
          ],
          "settings": {
            "foreground": "#ffffff"
          }
        },
        {
          "scope": [
            "variable.language",
            "variable.other.constant"
          ],
          "settings": {
            "foreground": "#00d4ff"
          }
        },
        {
          "scope": [
            "variable.other.enummember",
            "constant.other.enum"
          ],
          "settings": {
            "foreground": "#ffcc00"
          }
        },
        {
          "scope": [
            "entity.name.function.preprocessor",
            "meta.preprocessor.macro"
          ],
          "settings": {
            "foreground": "#ffcc00"
          }
        },
        {
          "scope": "constant.numeric",
          "settings": {
            "foreground": "#ff6b9d"
          }
        },
        {
          "scope": [
            "entity.name.tag",
            "support.class.component"
          ],
          "settings": {
            "foreground": "#00d4ff"
          }
        },
        {
          "scope": "entity.other.attribute-name",
          "settings": {
            "foreground": "#b8c5ff"
          }
        },
        {
          "scope": "comment",
          "settings": {
            "foreground": "#7cb668"
          }
        },
        {
          "scope": [
            "comment keyword.codetag",
            "comment.line keyword",
            "comment.block keyword"
          ],
          "settings": {
            "foreground": "#FF0000",
            "fontStyle": "bold"
          }
        },
        {
          "scope": [
            "punctuation.definition.template-expression"
          ],
          "settings": {
            "foreground": "#ff6b9d"
          }
        },
        {
          "scope": [
            "keyword.operator"
          ],
          "settings": {
            "foreground": "#ffffff"
          }
        },
        ,
        {
          "scope": [
            "support.function.tcl",
            "entity.name.function.tcl"
          ],
          "settings": {
            "foreground": "#00d4ff"
          }
        },
        {
          "scope": [
            "variable.other.tcl"
          ],
          "settings": {
            "foreground": "#ffffff"
          }
        },
        {
          "scope": [
            "constant.other.option.tcl",
            "support.function.tcl-option"
          ],
          "settings": {
            "foreground": "#ffa657"
          }
        },
        {
          "scope": [
            "keyword.control.tcl"
          ],
          "settings": {
            "foreground": "#ff6b9d"
          }
        }
      ]
    }
  },
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "workbench.colorCustomizations": {
    "editorCursor.foreground": "#ff3333",
    "editorBracketHighlight.foreground1": "#ffd700",
    "editorBracketHighlight.foreground2": "#da70d6",
    "editorBracketHighlight.foreground3": "#87ceeb",
    "editorBracketHighlight.foreground4": "#ff6347",
    "editorBracketHighlight.foreground5": "#98fb98",
    "editorBracketHighlight.foreground6": "#ffaa44"
  },
  "editor.formatOnSave": true,
  "files.associations": {
    "*.v": "verilog",
    "*.py": "python",
    "*.cu": "cuda-cpp",
    "*.cpp": "cpp"
  },
  "workbench.editorAssociations": {
    "*.u": "default"
  },
  "pylint.showNotifications": "onWarning",
  "vsicons.dontShowNewVersionMessage": true,
  "git.confirmSync": false,
  "git.autofetch": true,
  "[cuda-cpp]": {
    "editor.wordBasedSuggestions": "off",
    "editor.semanticHighlighting.enabled": true,
    "editor.stickyScroll.defaultModel": "foldingProviderModel",
    "editor.suggest.insertMode": "replace"
  },
  "[systemverilog]": {
    "editor.semanticHighlighting.enabled": true
  },
  "workbench.iconTheme": "material-icon-theme",
  "material-icon-theme.files.color": "#522DB0",
  "material-icon-theme.folders.color": "#F56600",
  "workbench.colorTheme": "GitHub Dark Default",
}
